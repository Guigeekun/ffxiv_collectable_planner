ffxivcollect.ggkfigment.fr {
    log {
        output stdout
    }

    root * /usr/share/caddy
    encode gzip
    file_server

    header {
        # Security headers
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API Proxy (matching vite.config.ts)
    handle /api/* {
        reverse_proxy https://lalachievements.com {
            header_up Host lalachievements.com
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Host {host}
            
            # Dynamic CORS to support any deployment domain
            header_down Access-Control-Allow-Origin {header.Origin}
            header_down Access-Control-Allow-Credentials "true"

            transport http {
                tls_server_name lalachievements.com
            }
        }
    }

    # SPA Fallback
    handle {
        try_files {path} /index.html
        file_server
    }
}
