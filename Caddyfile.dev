{
    # Global options
    # admin off # Optional: disable admin API if not needed
}

:80 {
    handle /api/* {
        reverse_proxy https://lalachievements.com {
            header_up Host lalachievements.com
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            transport http {
                tls_server_name lalachievements.com
            }
        }
    }

    # Reverse proxy to Vite dev server
    handle {
        reverse_proxy app:5173
    }
}
